{
  "name": "arca",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "100% client-side document/image/audio converter. No server, no API keys.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@firecrawl/anydoc-wasm": "^0.1.7",
    "@firecrawl/pdf-inspector-wasm": "^0.1.3",
    "@huggingface/transformers": "^4.2.0",
    "heic2any": "^0.0.4",
    "idb": "^8.0.3",
    "marked": "^18.0.9",
    "onnxruntime-web": "1.27.0",
    "pdfjs-dist": "^6.2.108",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "typescript": "^5.9.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
